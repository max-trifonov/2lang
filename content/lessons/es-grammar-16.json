  "title": {
    "ru": "Неправильные в настоящем: tengo, hago, salgo",
    "en": "Irregular present: tengo, hago, salgo",
    "es": "Verbos irregulares: tengo, hago, salgo"
  },
  "see": [
    "es-grammar-09",
    "es-grammar-17"
  ],
  "words": [
    "tener",
    "hacer",
    "salir"
  ],
  "pattern": [
    {
      "es": "Tengo dos hermanos.",
      "ru": "У меня два брата."
    },
    {
      "es": "Hago la cena hoy.",
      "ru": "Сегодня ужин готовлю я."
    },
