  "rule": {
    "text": {
      "ru": "Вежливая просьба — ¿Puedes + инфинитив? Наречие: cuidadoso → cuidadosamente. Código — мужской род, ударение на первый слог.",
      "en": "A polite request: ¿Puedes + infinitive? Adverb: cuidadoso → cuidadosamente. Código is masculine.",
      "es": "¿Puedes + infinitivo? cuidadoso → cuidadosamente."
    },
    "examples": [
      {
        "es": "¿Puedes revisar este archivo?",
        "ru": "Можешь проверить этот файл?"
      },
      {
        "es": "Reviso el código cada día.",
        "ru": "Я проверяю код каждый день."
      }
    ]
  },
