  "rule": {
    "text": {
      "ru": "Escribir — причастие escrito (he escrito). Todos — «все» + глагол во мн. числе: todos entienden. Claramente — «ясно».",
      "en": "Escribir has the irregular participle escrito (he escrito). Todos takes a plural verb: todos entienden. Claramente = clearly.",
      "es": "participio escrito. todos entienden."
    },
    "examples": [
      {
        "es": "He escrito el informe.",
        "ru": "Я написал отчёт."
      },
      {
        "es": "Todos entienden el plan.",
        "ru": "Все понимают план."
      }
    ]
  },
