  "title": {
    "ru": "Хочу, могу, нужно: querer / poder / necesitar + инфинитив",
    "en": "Want, can, need + infinitive",
    "es": "querer / poder / necesitar + infinitivo"
  },
  "see": [
    "es-grammar-17",
    "es-grammar-20",
    "es-grammar-34"
  ],
  "words": [
    "querer",
    "poder",
    "necesitar"
  ],
  "pattern": [
    {
      "es": "Quiero reservar una mesa.",
      "ru": "Я хочу забронировать столик."
    },
    {
      "es": "¿Puedo pagar con tarjeta?",
      "ru": "Можно оплатить картой?"
    },
    {
      "es": "Necesitamos cambiar la contraseña.",
      "ru": "Нам нужно сменить пароль."
    },
    {
      "es": "No puedo abrir el archivo.",
      "ru": "Я не могу открыть файл."
    }
  ],
  "rule": {
    "text": {
      "ru": "Первый глагол спрягается, второй — в начальной форме (на -ar, -er, -ir): quiero ir, puedes venir. ¿Puedo…? — «можно мне…?», ¿Puedes…? — «можешь…?» (просьба). Отрицание — перед первым глаголом: no puedo ir.",
      "en": "The first verb is conjugated, the second stays in the infinitive: quiero ir, puedes venir. ¿Puedo…? = may I, ¿Puedes…? = can you (request). no goes before the first verb.",
      "es": "Verbo conjugado + infinitivo. ¿Puedo…? permiso; ¿Puedes…? petición. no + primer verbo."
    },
    "formula": "querer / poder / necesitar (по лицам) + инфинитив",
    "table": {
      "head": [
        "",
        "хотеть",
        "мочь",
        "нуждаться"
      ],
      "rows": [
        [
          "yo",
          "quiero ir",
          "puedo ir",
          "necesito ir"
        ],
        [
          "tú",
          "quieres ir",
          "puedes ir",
          "necesitas ir"
        ],
        [
          "él, ella, usted",
          "quiere ir",
          "puede ir",
          "necesita ir"
        ],
        [
          "nosotros",
          "queremos ir",
          "podemos ir",
          "necesitamos ir"
        ],
        [
          "ellos, ustedes",
          "quieren ir",
          "pueden ir",
          "necesitan ir"
        ]
      ]
    },
    "timeline": [
      {
        "from": "now",
        "until": "future",
        "label": {
          "ru": "желание или возможность сейчас и потом",
          "en": "wish or ability now and later",
          "es": "deseo o posibilidad ahora y después"
        }
      }
    ]
  },
  "bridge": [
    {
      "lang": "en",
      "lesson": "en-grammar-15",
      "formula": "want to / can / need to + V",
