  "rule": {
    "text": {
      "ru": "Прошлое, связанное с «сейчас»: сегодня, на этой неделе, «уже / ещё не», опыт в жизни. haber + причастие: hablar → hablado, comer → comido, vivir → vivido. Неправильные: hecho, visto, dicho, escrito, puesto, abierto, vuelto. Между he и причастием ничего не ставят: no lo he visto.",
      "en": "Past linked to now: today, this week, already / not yet, life experience. haber + past participle: hablado, comido, vivido. Irregular: hecho, visto, dicho, escrito, puesto, abierto, vuelto. Nothing goes between haber and the participle.",
      "es": "haber + participio: pasado relacionado con el presente (hoy, esta semana, ya, todavía no, experiencia). Participios irregulares: hecho, visto, dicho, escrito."
    },
    "formula": "haber (he, has, ha, hemos, habéis, han) + -ado / -ido",
    "table": {
      "head": [
        "",
        "haber",
        "+ причастие"
      ],
      "rows": [
        [
          "yo",
          "he",
          "trabajado"
        ],
        [
          "tú",
          "has",
          "comido"
        ],
        [
          "él, ella, usted",
          "ha",
          "hecho"
        ],
        [
          "nosotros",
          "hemos",
          "visto"
        ],
        [
          "vosotros",
          "habéis",
          "dicho"
        ],
        [
          "ellos, ustedes",
          "han",
          "escrito"
        ]
      ]
    },
    "timeline": [
      {
        "from": "past",
        "until": "now",
        "label": {
          "ru": "случилось в прошлом, важно сейчас",
          "en": "happened before, matters now",
          "es": "pasó antes, importa ahora"
        }
      }
    ]
  },
  "bridge": [
    {
      "lang": "en",
      "lesson": "en-grammar-29",
      "formula": "have + V3",
      "examples": [
