  "title": {
    "ru": "Настоящее время: глаголы на -er и -ir",
    "en": "Present tense: -er and -ir verbs",
    "es": "Presente: verbos en -er / -ir"
  },
  "see": [
    "es-grammar-08",
    "es-grammar-16"
  ],
  "pattern": [
    {
      "es": "Como en casa.",
      "ru": "Я ем дома."
    },
    {
      "es": "¿Vives cerca del centro?",
      "ru": "Ты живёшь рядом с центром?"
    },
    {
      "es": "Escribimos el código juntos.",
      "ru": "Мы пишем код вместе."
    },
    {
      "es": "Ellos leen las noticias.",
      "ru": "Они читают новости."
    }
  ],
  "rule": {
    "text": {
      "ru": "-er и -ir спрягаются почти одинаково: отличаются только «мы» и «вы» (comemos / vivimos, coméis / vivís). Сначала уберите -er / -ir, затем добавьте окончание.",
      "en": "-er and -ir verbs differ only in nosotros and vosotros (comemos / vivimos, coméis / vivís). Drop -er / -ir and add the ending.",
      "es": "-er e -ir solo se diferencian en nosotros y vosotros: comemos / vivimos."
    },
    "formula": "-er: -o, -es, -e, -emos, -éis, -en · -ir: -o, -es, -e, -imos, -ís, -en",
    "table": {
      "head": [
        "",
        "comer",
        "vivir"
      ],
      "rows": [
        [
          "yo",
          "como",
          "vivo"
        ],
        [
          "tú",
          "comes",
          "vives"
        ],
        [
          "él, ella, usted",
          "come",
          "vive"
        ],
        [
          "nosotros",
          "comemos",
          "vivimos"
        ],
        [
          "vosotros",
          "coméis",
          "vivís"
        ],
        [
          "ellos, ustedes",
          "comen",
          "viven"
        ]
      ]
    },
    "timeline": [
      {
        "from": "now",
        "label": {
          "ru": "сейчас и обычно",
          "en": "now and usually",
          "es": "ahora y habitualmente"
        }
      }
    ]
  },
  "exercises": [
    {
      "type": "transform",
      "es": "Vives en Madrid.",
      "into": [
        {
          "form": "negative",
          "answer": "No vives en Madrid."
        },
        {
          "form": "question",
          "answer": "¿Vives en Madrid?"
        }
      ]
    },
    {
      "type": "choose",
      "es": "Nosotros ___ en el centro.",
      "options": [
        "vivemos",
        "vivimos",
        "viven"
      ],
      "answer": "vivimos",
      "ru": "Мы живём в центре."
    },
    {
      "type": "choose",
      "es": "¿Tú ___ carne?",
      "options": [
        "comes",
        "come",
        "comemos"
      ],
      "answer": "comes",
      "ru": "Ты ешь мясо?"
    },
    {
      "type": "fill",
      "es": "Ana ___ un correo al cliente. (escribir)",
      "answer": "escribe",
      "ru": "Ана пишет письмо клиенту."
    },
    {
      "type": "fill",
      "es": "¿Qué ___ vosotros? (beber)",
      "answer": "bebéis",
      "ru": "Что вы пьёте?"
    },
    {
      "type": "build",
      "es": "Mis padres viven en un pueblo pequeño.",
      "ru": "Мои родители живут в маленьком городке.",
      "extra": [
        "vivimos"
      ]
    },
    {
      "type": "compose",
      "prompt": {
        "ru": "Напишите, где вы живёте и что обычно едите на завтрак.",
        "en": "Write where you live and what you usually eat for breakfast.",
        "es": "Escribe dónde vives y qué comes en el desayuno."
      },
      "template": "Vivo en … Como …",
      "sample": "Vivo en Moscú. Como pan y queso."
    }
  ],
