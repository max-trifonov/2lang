    },
    {
      "type": "choose",
      "en": "It ___ cold today.",
      "options": [
        "doesn't",
        "isn't"
      ],
      "answer": "isn't",
      "ru": "Сегодня не холодно."
    },
    {
      "type": "build",
      "en": "My phone doesn't work today.",
      "ru": "Мой телефон сегодня не работает.",
      "extra": [
        "works"
      ]
    },
    {
      "type": "compose",
      "prompt": {
        "ru": "Напишите три вещи, которые вы не делаете (или не любите).",
        "en": "Write three things you don't do (or don't like).",
        "es": "Escribe tres cosas que no haces (o no te gustan)."
      },
      "template": "I don't …",
      "sample": "I don't drink coffee. I don't like long meetings. I can't sing."
    }
  ],
