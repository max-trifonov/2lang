  "rule": {
    "text": {
      "ru": "Для «ты» — форма как у él в настоящем: habla, come, escribe. Неправильные: ven, di, haz, pon, sal, ten, ve (ir). Для вежливого usted — гласная меняется: hablar → hable, comer → coma, tener → tenga. Отрицание строится по-другому: no hables, no comas. Местоимения прикрепляются к утвердительной форме: dímelo, siéntese.",
      "en": "For tú use the él present form: habla, come. Irregular: ven, di, haz, pon, sal, ten, ve. For usted the vowel switches: hable, coma, tenga. Negative changes form: no hables, no comas. Pronouns attach to the affirmative: dímelo.",
      "es": "Tú = 3.ª persona del presente; usted: -ar → -e, -er/-ir → -a. Negativo: no hables. Pronombres enclíticos en afirmativo."
    },
    "formula": "tú: как «он» в presente (habla) · usted: -ar → -e, -er/-ir → -a (hable, coma)",
    "table": {
      "head": [
        "",
        "tú",
        "usted",
        "нельзя (tú)"
      ],
      "rows": [
        [
          "hablar",
          "habla",
          "hable",
          "no hables"
        ],
        [
          "comer",
          "come",
          "coma",
          "no comas"
        ],
        [
          "abrir",
          "abre",
          "abra",
          "no abras"
        ],
        [
          "venir",
          "ven",
          "venga",
          "no vengas"
        ],
        [
          "hacer",
          "haz",
          "haga",
          "no hagas"
        ]
      ]
    }
  },
  "bridge": [
    {
      "lang": "en",
      "lesson": "en-grammar-26",
      "formula": "V / Don't + V / Let's",
      "examples": [
        {
          "en": "Open the window, please.",
          "ru": "Открой окно, пожалуйста."
        }
      ],
      "note": {
        "ru": "в английском одна форма для всех: open, don't open"
      }
    }
  ],
