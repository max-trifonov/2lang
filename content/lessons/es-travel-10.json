  "phrase": {
    "es": "Estoy perdido: busco el camino al hotel.",
    "ru": "Я заблудился: ищу дорогу к отелю.",
    "en": "I'm lost: I'm looking for the way to the hotel."
  },
  "rule": {
    "text": {
      "ru": "«Я заблудился» — estoy perdido (о женщине — perdida): это состояние, поэтому estar. buscar — «искать», без предлога: Busco el hotel.",
      "en": "“I’m lost” is estoy perdido (a woman says perdida): a state, so estar. buscar means “to look for”, with no preposition: Busco el hotel.",
      "es": "Estoy perdido / perdida: es un estado, por eso estar. buscar sin preposición: Busco el hotel."
    },
    "examples": [
      {
        "es": "Busco la estación de tren.",
        "ru": "Я ищу вокзал."
      },
      {
        "es": "Estamos perdidos. ¿Tiene un mapa?",
        "ru": "Мы заблудились. У вас есть карта?"
      }
    ]
  },
  "exercises": [
