  "rule": {
    "text": {
      "ru": "Привычки, расписания, факты: «обычно, всегда, каждый день». Глагол не меняется, кроме he / she / it: +s (works), после s, sh, ch, x, o — +es (watches, goes), согласная + y → ies (studies). have → has. Слова-подсказки: always, usually, often, every day, on Mondays.",
      "en": "Habits, schedules, facts. The verb only changes for he / she / it: +s (works), +es after s, sh, ch, x, o (watches, goes), consonant + y → ies (studies). have → has. Signals: always, usually, every day.",
      "es": "Hábitos y hechos. 3.ª persona: -s / -es / -ies. have → has."
    },
    "formula": "I / you / we / they + V · he / she / it + V-s",
    "table": {
      "head": [
        "",
        "work",
        "go",
        "have"
      ],
      "rows": [
        [
          "I, you, we, they",
          "work",
          "go",
          "have"
        ],
        [
          "he, she, it",
          "works",
          "goes",
          "has"
        ]
      ]
    },
    "timeline": [
      {
        "from": "past",
        "until": "future",
        "label": {
          "ru": "всегда, регулярно",
          "en": "always, regularly",
          "es": "siempre, habitualmente"
        }
      }
    ]
  },
  "bridge": [
    {
      "lang": "es",
      "lesson": "es-grammar-08",
      "formula": "presente: trabajo, trabaja",
      "examples": [
        {
          "es": "Trabajo desde casa.",
          "ru": "Я работаю из дома."
        }
      ],
      "note": {
        "ru": "в испанском окончание у каждого лица, в английском — только -s у he / she / it"
      }
    }
  ],
