  "pattern": [
    {
      "es": "Ayer trabajé hasta las ocho.",
      "ru": "Вчера я работал до восьми."
    },
    {
      "es": "¿Compraste los billetes?",
      "ru": "Ты купил билеты?"
    },
    {
      "es": "El año pasado viajamos a México.",
      "ru": "В прошлом году мы ездили в Мексику."
    },
    {
      "es": "Me escribió un correo.",
      "ru": "Он написал мне письмо."
    }
  ],
  "rule": {
    "text": {
      "ru": "Законченное действие в прошлом с моментом, который уже прошёл: ayer, la semana pasada, en 2020, hace dos días. Ударение на окончании важно: trabajo («я работаю») ≠ trabajó («он работал»). В «мы» у -ar и -ir форма совпадает с настоящим: hablamos — по контексту.",
      "en": "A finished action at a past time: ayer, la semana pasada, en 2020, hace dos días. Stress matters: trabajo (I work) ≠ trabajó (he worked). For -ar and -ir, nosotros is the same as present.",
      "es": "Acción terminada en un tiempo pasado (ayer, el año pasado). trabajo ≠ trabajó."
    },
    "formula": "-ar: -é, -aste, -ó, -amos, -asteis, -aron · -er/-ir: -í, -iste, -ió, -imos, -isteis, -ieron",
    "table": {
      "head": [
        "",
        "trabajar",
        "comer",
        "escribir"
      ],
      "rows": [
        [
          "yo",
          "trabajé",
          "comí",
          "escribí"
        ],
        [
          "tú",
          "trabajaste",
          "comiste",
          "escribiste"
        ],
        [
          "él, ella, usted",
          "trabajó",
          "comió",
          "escribió"
        ],
        [
          "nosotros",
          "trabajamos",
          "comimos",
          "escribimos"
        ],
        [
          "vosotros",
          "trabajasteis",
          "comisteis",
          "escribisteis"
        ],
        [
          "ellos, ustedes",
          "trabajaron",
          "comieron",
          "escribieron"
        ]
      ]
    },
    "timeline": [
      {
        "from": "past",
        "label": {
          "ru": "закончилось в прошлом, момент назван",
          "en": "finished at a stated past time",
          "es": "terminó en un momento pasado"
        }
      }
    ]
  },
  "bridge": [
    {
      "lang": "en",
      "lesson": "en-grammar-19",
      "formula": "Past Simple: worked, wrote",
      "examples": [
        {
          "en": "Yesterday I worked until eight.",
          "ru": "Вчера я работал до восьми."
        }
      ],
      "note": {
        "ru": "Past Simple ≈ indefinido; Present Perfect ≈ perfecto"
      }
    }
  ],
  "exercises": [
    {
      "type": "transform",
      "es": "Compro un regalo.",
      "into": [
