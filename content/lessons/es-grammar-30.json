    {
      "type": "choose",
      "es": "¿Dónde ___ tus vacaciones?",
      "options": [
        "pasaste",
        "pasó"
      ],
      "answer": "pasaste",
      "ru": "Где ты провёл отпуск?"
    },
    {
      "type": "fill",
      "es": "Ellos ___ en un restaurante italiano. (comer, ayer)",
      "answer": "comieron",
      "ru": "Они ели в итальянском ресторане."
    },
    {
      "type": "build",
      "es": "La semana pasada terminamos el proyecto.",
      "ru": "На прошлой неделе мы закончили проект.",
      "extra": [
        "terminé"
      ]
    },
    {
      "type": "compose",
      "prompt": {
        "ru": "Напишите, что вы делали вчера.",
        "en": "Write what you did yesterday.",
        "es": "Escribe qué hiciste ayer."
      },
      "template": "Ayer …",
      "sample": "Ayer trabajé mucho y cené con mis amigos."
    }
  ],
