  "rule": {
    "text": {
      "ru": "Законченное действие в прошлом с понятным моментом: yesterday, last week, two days ago, in 2020. Правильные глаголы: +ed (worked, stopped, studied), одна форма для всех лиц. Неправильные учат: go → went, have → had, do → did, see → saw, make → made, get → got, buy → bought.",
      "en": "A finished action at a known past time: yesterday, last week, two days ago. Regular verbs: +ed, one form for all persons. Irregulars must be learned: went, had, did, saw, made, got, bought.",
      "es": "Acción terminada en el pasado. Regulares -ed; irregulares: went, had, did, saw."
    },
    "formula": "V-ed (правильные) · 2-я форма (неправильные): go → went",
    "table": {
      "head": [
        "инфинитив",
        "Past Simple"
      ],
      "rows": [
        [
          "work, stop, study",
          "worked, stopped, studied"
        ],
        [
          "go, have, do",
          "went, had, did"
        ],
        [
          "see, make, get",
          "saw, made, got"
        ],
        [
          "buy, take, come",
          "bought, took, came"
        ]
      ]
    },
    "timeline": [
      {
        "from": "past",
        "label": {
          "ru": "закончилось в прошлом, момент известен",
          "en": "finished at a known past time",
          "es": "terminó en un momento pasado conocido"
        }
      }
    ]
  },
  "bridge": [
