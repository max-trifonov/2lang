  "rule": {
    "text": {
      "ru": "Отбросьте -ar и добавьте окончание лица: hablar → hablo, hablas, habla… Presente — это и «сейчас», и «обычно», и ближайшие планы: Mañana trabajo en casa. Большинство испанских глаголов — на -ar и правильные.",
      "en": "Drop -ar and add the person ending: hablar → hablo, hablas, habla… The present covers now, habits and near plans: Mañana trabajo en casa.",
      "es": "Raíz + -o, -as, -a, -amos, -áis, -an. El presente expresa hábitos, el ahora y planes próximos."
    },
    "formula": "основа + -o, -as, -a, -amos, -áis, -an",
    "table": {
      "head": [
        "",
        "hablar",
        "trabajar"
      ],
      "rows": [
        [
          "yo",
          "hablo",
          "trabajo"
        ],
        [
          "tú",
          "hablas",
          "trabajas"
        ],
        [
          "él, ella, usted",
          "habla",
          "trabaja"
        ],
        [
          "nosotros",
          "hablamos",
          "trabajamos"
        ],
        [
          "vosotros",
          "habláis",
          "trabajáis"
        ],
        [
          "ellos, ustedes",
          "hablan",
          "trabajan"
        ]
      ]
    },
    "timeline": [
      {
        "from": "now",
        "label": {
          "ru": "сейчас и обычно",
          "en": "now and usually",
          "es": "ahora y habitualmente"
        }
      }
    ]
  },
  "bridge": [
    {
      "lang": "en",
      "lesson": "en-grammar-07",
      "formula": "Present Simple: I work, he works",
      "examples": [
        {
          "en": "I work in an IT company.",
          "ru": "Я работаю в IT-компании."
        }
      ],
      "note": {
        "ru": "в английском окончание только у he / she / it (-s)"
      }
    }
  ],
