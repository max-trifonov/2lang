          "form": "negative",
          "answer": "No tengo que trabajar hoy."
        },
        {
          "form": "question",
          "answer": "¿Tengo que trabajar hoy?"
        }
      ]
    },
    {
      "type": "choose",
      "es": "Nosotros ___ que salir a las ocho.",
      "options": [
        "tengo",
        "tenemos",
        "tienen"
      ],
      "answer": "tenemos",
      "ru": "Нам нужно выйти в восемь."
    },
    {
      "type": "choose",
      "es": "Para entrar ___ mostrar el pasaporte.",
      "options": [
        "hay que",
        "tengo"
      ],
      "answer": "hay que",
      "ru": "Чтобы войти, надо показать паспорт."
    },
    {
      "type": "choose",
      "es": "No ___ fumar aquí.",
      "options": [
        "debes",
        "tienes"
      ],
      "answer": "debes",
      "ru": "Здесь не следует курить."
    },
    {
      "type": "fill",
      "es": "¿___ que pagar ahora?",
      "answer": [
        "Tengo",
        "Tenemos",
        "Tienes"
      ],
      "ru": "Нужно платить сейчас?"
    },
    {
      "type": "build",
      "es": "Tenemos que hacer un deploy hoy.",
      "ru": "Нам нужно сделать деплой сегодня.",
      "extra": [
        "tiene"
      ]
    },
    {
      "type": "compose",
      "prompt": {
        "ru": "Напишите, что вам нужно сделать завтра.",
        "en": "Write what you have to do tomorrow.",
        "es": "Escribe qué tienes que hacer mañana."
      },
      "template": "Mañana tengo que …",
      "sample": [
        "Mañana tengo que ir al aeropuerto.",
        "Mañana tengo que trabajar."
      ]
    }
  ],
