  "rules": [
    {
      "id": "es-n-tilde",
      "title": {
        "ru": "ñ — отдельная буква",
        "en": "ñ is a separate letter",
        "es": "La ñ es una letra"
      },
      "text": {
        "ru": "ñ читается как мягкое «нь» [ɲ] и стоит в алфавите после n. Без тильды это другое слово: año «год», ano — совсем не то.",
        "en": "ñ sounds like “ny” in canyon [ɲ] and comes after n. Without the tilde it is a different word: año “year”.",
        "es": "La ñ suena [ɲ] y va después de la n en el alfabeto. Sin tilde es otra palabra."
      },
      "ipa": "ɲ",
      "examples": [
        {
          "es": "año",
          "ru": "год"
        },
        {
          "es": "mañana",
          "ru": "завтра, утро"
        },
        {
          "es": "España",
          "ru": "Испания"
        }
      ]
    }
