  "rule": {
    "text": {
      "ru": "Инструкция и просьба — глагол в начальной форме без подлежащего: Open the file. Запрет — Don't + V: Don't touch. Одна форма для «ты» и «вы»; вежливость добавляют please и интонация. «Давай(те)» — Let's + V, «давай не будем» — Let's not…",
      "en": "Instructions: the base verb, no subject: Open the file. Prohibition: Don't + V. One form for everyone; add please for politeness. Suggestion: Let's + V; Let's not…",
      "es": "Verbo base para todos; Don't + verbo; Let's = vamos a…"
    },
    "formula": "V! · Don't + V! · Let's + V · Let's not + V",
    "table": {
      "head": [
        "",
        "пример"
      ],
      "rows": [
        [
          "инструкция",
          "Save the file."
        ],
        [
          "запрет",
          "Don't close the window."
        ],
        [
          "предложение",
          "Let's go."
        ],
        [
          "«давай не будем»",
          "Let's not wait."
        ]
      ]
    }
  },
  "bridge": [
    {
      "lang": "es",
      "lesson": "es-grammar-28",
      "formula": "imperativo: abre / abra / no abras",
      "examples": [
        {
          "es": "Abre la ventana, por favor.",
          "ru": "Открой окно, пожалуйста."
        }
      ],
      "note": {
        "ru": "в испанском разные формы для tú и usted, и особая форма для запрета"
      }
    }
  ],
  "exercises": [
    {
      "type": "transform",
      "en": "You close the door.",
      "into": [
        {
          "form": "imperative",
          "answer": [
            "Close the door.",
            "Close the door, please."
          ]
        }
      ]
    },
    {
      "type": "transform",
      "en": "You touch the screen.",
      "into": [
        {
          "form": "negative",
          "answer": [
            "Don't touch the screen.",
            "Do not touch the screen."
          ]
        }
      ]
    },
    {
