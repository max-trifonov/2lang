            "¿Tienes reserva?"
          ]
        }
      ]
    },
    {
      "type": "transform",
      "es": "El tren sale a las ocho.",
      "into": [
        {
          "form": "question",
          "answer": [
            "¿El tren sale a las ocho?",
            "¿Sale el tren a las ocho?"
          ]
        }
      ]
    },
    {
      "type": "choose",
      "es": "¿Necesitas ayuda? — No, no ___.",
      "options": [
        "necesito",
        "necesitas"
      ],
      "answer": "necesito",
      "ru": "Тебе нужна помощь? — Нет, не нужна."
    },
    {
      "type": "choose",
      "es": "¿Está abierto el museo? — Sí, ___.",
      "options": [
        "está",
        "es",
        "hay"
      ],
      "answer": "está",
      "ru": "Музей открыт? — Да."
    },
    {
      "type": "build",
      "es": "¿Hay una farmacia cerca?",
      "ru": "Рядом есть аптека?",
      "extra": [
        "está"
      ]
    },
    {
      "type": "compose",
      "prompt": {
        "ru": "Задайте три вопроса новому коллеге (да / нет).",
        "en": "Ask a new colleague three yes / no questions.",
        "es": "Haz tres preguntas de sí / no a un compañero nuevo."
      },
      "template": "¿…?",
      "sample": "¿Vives cerca? ¿Hablas inglés? ¿Tienes coche?"
    }
  ],
