  "rule": {
    "text": {
      "ru": "hay — одна форма для ед. и мн. числа: «есть, имеется». После hay — без el / la: hay un banco. Про известный предмет «где он» — estar: El banco está aquí. Вопрос — ¿Hay…?, отрицание — No hay…",
      "en": "hay is one form for singular and plural: “there is / there are”. No el / la after it: hay un banco. For where a known thing is, use estar: El banco está aquí.",
      "es": "hay (invariable) + sin artículo determinado. Para ubicar algo conocido: estar."
    },
    "formula": "hay + (un / una / число / mucho) + существительное",
    "table": {
      "head": [
        "",
        "что-то есть (hay)",
        "где оно (estar)"
      ],
      "rows": [
        [
          "ед. ч.",
          "Hay un banco aquí.",
          "El banco está aquí."
        ],
        [
          "мн. ч.",
          "Hay dos bancos.",
          "Los bancos están aquí."
        ],
        [
          "вопрос",
          "¿Hay un banco cerca?",
          "¿Dónde está el banco?"
        ]
      ]
    }
  },
  "bridge": [
    {
      "lang": "en",
      "lesson": "en-grammar-05",
      "formula": "there is / there are",
      "examples": [
        {
          "en": "Is there a café near the hotel?",
          "ru": "Рядом с отелем есть кафе?"
        }
      ],
      "note": {
        "ru": "there is / there are ≈ hay, но hay одна форма"
      }
    }
  ],
