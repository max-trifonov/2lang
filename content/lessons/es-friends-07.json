  "rule": {
    "text": {
      "ru": "Предложение — форма «мы» в вопросе: ¿Vemos…? («Давай посмотрим?»). Ver — «смотреть» кино и ТВ; mirar — «смотреть на».",
      "en": "A suggestion: the \"we\" form as a question: ¿Vemos…? We use ver for films and TV; mirar means \"to look at\".",
      "es": "¿Vemos…? = ¿Quieres que veamos…? ver una película."
    },
    "examples": [
      {
        "es": "¿Vemos algo en la tele?",
        "ru": "Посмотрим что-нибудь по телевизору?"
      },
      {
        "es": "La película es muy buena.",
        "ru": "Фильм очень хороший."
      }
    ]
  },
