  "title": {
    "ru": "Present Perfect: результат и опыт",
    "en": "Present Perfect: result and experience",
    "es": "Present Perfect: resultado y experiencia"
  },
  "see": [
    "en-grammar-30",
    "en-grammar-38",
    "en-grammar-19"
  ],
  "words": [
    "already",
    "yet"
  ],
  "pattern": [
    {
      "en": "I have finished the task.",
      "ru": "Я закончил задачу."
    },
    {
      "en": "Have you ever been to Mexico?",
      "ru": "Ты когда-нибудь был в Мексике?"
    },
    {
      "en": "She has just arrived.",
      "ru": "Она только что приехала."
    },
    {
      "en": "We haven't decided yet.",
      "ru": "Мы ещё не решили."
    }
  ],
  "rule": {
    "text": {
      "ru": "Прошлое, важное сейчас: результат (I've lost my keys — их нет), опыт в жизни (ever, never), «только что / уже / ещё не» (just, already, yet). Конкретное время (yesterday, in 2020) с ним не употребляют. 3-я форма: правильные +ed, неправильные учат: done, been, seen, gone, made, written. yet — в конце вопроса и отрицания, just и already — между have и глаголом.",
      "en": "Past linked to now: a result (I've lost my keys), life experience (ever, never), just / already / yet. No specific past time (yesterday). Past participle: +ed or irregular (done, been, seen, gone, written). yet at the end; just and already between have and the verb.",
      "es": "have / has + participio: resultado, experiencia, just / already / yet. Sin tiempo concreto."
    },
    "formula": "have / has + V3 (worked, done, been)",
    "table": {
      "head": [
        "",
        "+",
        "−",
        "?"
      ],
      "rows": [
        [
          "I, you, we, they",
          "I've done",
          "I haven't done",
          "Have you done?"
        ],
        [
          "he, she, it",
          "she's done",
          "she hasn't done",
          "Has she done?"
        ]
      ]
    },
    "timeline": [
      {
        "from": "past",
        "until": "now",
        "label": {
          "ru": "случилось раньше, важно сейчас",
          "en": "happened before, matters now",
          "es": "pasó antes, importa ahora"
        }
      }
    ]
  },
  "bridge": [
    {
      "lang": "es",
      "lesson": "es-grammar-27",
      "formula": "haber + participio: he terminado",
      "examples": [
        {
          "es": "He terminado la tarea.",
          "ru": "Я закончил задачу."
        }
      ],
      "note": {
        "ru": "близко к pretérito perfecto (в Испании)"
      }
    }
  ],
