      "es": "Hoy hace ___ tiempo.",
      "options": [
        "buen",
        "bien",
        "bueno"
      ],
      "answer": "buen",
      "ru": "Сегодня хорошая погода."
    },
    {
      "type": "choose",
      "es": "¿Estás ___? Pareces cansado.",
      "options": [
        "bien",
        "bueno"
      ],
      "answer": "bien",
      "ru": "Ты в порядке? Выглядишь усталым."
    },
    {
      "type": "build",
      "es": "Mi hermano es un buen cocinero.",
      "ru": "Мой брат — хороший повар.",
      "extra": [
        "bien"
      ]
    },
    {
      "type": "compose",
      "prompt": {
        "ru": "Напишите, что у вас хорошее (bueno) и что вы хорошо делаете (bien).",
        "en": "Write something good you have and something you do well.",
        "es": "Escribe algo bueno que tienes y algo que haces bien."
      },
      "template": "Tengo un buen … … bien.",
      "sample": "Tengo un buen trabajo. Cocino bien."
    }
  ],
