  "code": "ES-43",
  "order": 43,
  "level": "A1",
  "title": {
    "ru": "bueno или bien",
    "en": "bueno or bien",
    "es": "bueno o bien"
  },
  "see": [
    "es-grammar-13",
    "es-grammar-25"
  ],
  "pattern": [
    {
      "es": "Es un buen libro.",
      "ru": "Это хорошая книга."
    },
    {
      "es": "Escribe muy bien.",
      "ru": "Он очень хорошо пишет."
    },
    {
      "es": "¿Qué tal? — Bien, gracias.",
      "ru": "Как дела? — Хорошо, спасибо."
    },
    {
      "es": "La sopa está buena.",
      "ru": "Суп вкусный."
    }
  ],
  "rule": {
    "text": {
      "ru": "bueno — прилагательное, согласуется с существительным: un libro bueno, una idea buena, buenos amigos; перед существительным м. р. ед. ч. — buen: un buen día. bien — наречие, не меняется: описывает, как выполняется действие (cantas bien) и самочувствие (estoy bien). С estar: estar bien — «в порядке», estar bueno — «вкусный» (о еде) или разговорно «привлекательный».",
      "en": "bueno is an adjective (agrees, buen before a masculine singular noun). bien is an adverb (cantas bien, estoy bien). La sopa está buena = the soup is tasty.",
      "es": "bueno = adjetivo (buen libro); bien = adverbio (canta bien, estoy bien)."
    },
    "formula": "bueno, -a — какой (прилагательное) · bien — как (наречие)",
    "table": {
      "head": [
        "",
        "bueno",
        "bien"
      ],
      "rows": [
        [
          "что описывает",
          "вещь, человека",
          "действие, самочувствие"
        ],
        [
          "пример",
          "un buen médico",
          "Trabaja bien."
        ],
        [
          "с estar",
          "está bueno (вкусно)",
          "estoy bien (в порядке)"
        ]
      ]
    }
  },
  "bridge": [
    {
      "lang": "en",
      "lesson": "en-grammar-50",
      "formula": "good / well",
      "examples": [
        {
          "en": "She is a good singer. She sings well.",
          "ru": "Она хорошая певица. Она хорошо поёт."
        }
      ],
      "note": {
        "ru": "та же пара: good = bueno, well = bien"
      }
    }
  ],
  "exercises": [
    {
