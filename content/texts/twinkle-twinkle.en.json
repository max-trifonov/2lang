  "stanzas": [
    {
      "id": "chorus",
      "type": "chorus",
      "lines": [
        {
          "en": "Twinkle, twinkle, little star,",
          "ru": "Мерцай, мерцай, звёздочка,",
          "lit": { "ru": "Мерцай, мерцай, маленькая звезда," },
          "words": [
            { "en": "twinkle", "lemma": "twinkle", "pos": "verb", "ru": "мерцать" }
          ]
        },
        {
          "en": "How I wonder what you are!",
          "ru": "Как хочу я знать, кто ты!",
          "lit": { "ru": "Как же я гадаю, что ты такое!" },
          "phrases": [
            {
              "en": "I wonder what",
              "ru": "интересно, что",
              "note": { "ru": "I wonder + вопросительное слово: мягкий способ задать вопрос. I wonder what time it is — интересно, который час" }
            }
          ],
          "words": [
            { "en": "wonder", "lemma": "wonder", "pos": "verb", "ru": "задаваться вопросом, интересоваться" }
          ]
        }
      ]
    },
    {
      "lines": [
        {
          "en": "Up above the world so high,",
          "ru": "Высоко-высоко над миром,",
          "phrases": [
            { "en": "up above", "ru": "высоко над" }
          ]
        },
        {
          "en": "Like a diamond in the sky.",
          "ru": "Как алмаз на небе.",
          "phrases": [
            { "en": "in the sky", "ru": "в небе" }
          ]
        }
      ]
    },
    { "ref": "chorus" }
  ]
